# ==========================================
# THREAD CITY - DEVELOPMENT ENVIRONMENT
# ==========================================
NODE_ENV=development
PORT=3000

# Kết nối MySQL máy host qua cổng map 3308 của server/docker-compose.yml
DATABASE_URL="mysql://thread_user:thread_password@localhost:3308/thread_city"

# Kết nối Redis máy host qua cổng 6379
REDIS_URL="redis://localhost:6379"

# Khóa bí mật ký JWT (dùng để test local)
JWT_SECRET="dev_secret_key_change_me_in_production"

# Cấu hình Prisma CLI
PRISMA_CLI_QUERY_ENGINE_TYPE="library"
PRISMA_CLIENT_ENGINE_TYPE="library"

# Cấu hình Email gửi OTP (Dùng 1 trong các cách sau):
# Cách 1 (Khuyên dùng trên Render): Resend API (HTTPS Port 443 - Không bị Render chặn)
# RESEND_API_KEY="re_xxxxxxxxxxxxxx"
# RESEND_FROM="Thread City <onboarding@resend.dev>"

# Cách 2: SMTP truyền thống (Chỉ chạy được ở local hoặc server có mở port 465/587)
# SMTP_USER="your_email@gmail.com"
# SMTP_PASS="your_app_password"
