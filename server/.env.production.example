# ==========================================
# THREAD CITY - PRODUCTION ENVIRONMENT (TEMPLATE)
# ==========================================
NODE_ENV=production
PORT=3000

# Khóa JWT bí mật cho Production (Cần tạo chuỗi ngẫu nhiên dài, an toàn)
JWT_SECRET=your_super_strong_production_jwt_secret_change_me

# Cấu hình MySQL Container
MYSQL_DATABASE=thread_city
MYSQL_USER=thread_user
MYSQL_PASSWORD=change_this_to_a_strong_password
MYSQL_ROOT_PASSWORD=change_this_to_a_strong_root_password

# Chuỗi kết nối Database nội bộ Docker (sử dụng hostname 'mysql' và cổng 3306)
DATABASE_URL="mysql://thread_user:change_this_to_a_strong_password@mysql:3306/thread_city"

# Chuỗi kết nối Redis nội bộ Docker (sử dụng hostname 'redis' và cổng 6379)
REDIS_URL="redis://redis:6379"

# Prisma Engine
PRISMA_CLI_QUERY_ENGINE_TYPE="library"
PRISMA_CLIENT_ENGINE_TYPE="library"
